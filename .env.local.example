# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to git.

# ─── v9 STEALTH-LAUNCH CONFIG ────────────────────────────────────────
#
# Stealth mode redirects every URL except / and /demo to the coming-soon
# homepage. Set to 'false' (string) when you're ready to launch the full
# marketing site publicly.
NEXT_PUBLIC_STEALTH_MODE=true
#
# Password for /demo access during stealth launch.
# Make it memorable but not guessable. Share with friendly testers via
# email or text. Rotating this value instantly invalidates all existing
# tester cookies — clean way to revoke access.
DEMO_PASSWORD=loanmates2026

# ─── Calendly booking URLs ───────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_BORROWER=https://calendly.com/jason-ratem8/talk-to-jason
NEXT_PUBLIC_CALENDLY_AGENT=https://calendly.com/jason-ratem8/agent-partnership

# ─── Email forwarding for /demo chat input box (v7) ─────────────────
RESEND_API_KEY=
JASON_NOTIFICATION_EMAIL=jason@ratem8.com
RATEM8_FROM_EMAIL=m8@ratem8.com

# ─── Reserved for v10 (live M8 chat via Claude API) ──────────────────
# ANTHROPIC_API_KEY=
