# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to git.

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://loanm8.com
# Public contact address rendered on the site. Leave empty to show the
# bracketed placeholder from lib/config.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Calendly booking URLs (every consumer CTA is one of these) ──────
# Empty → the CTA renders as "Booking link coming soon", never a dead link.
NEXT_PUBLIC_CALENDLY_BORROWER=
NEXT_PUBLIC_CALENDLY_AGENT=
NEXT_PUBLIC_CALENDLY_MLO=
NEXT_PUBLIC_CALENDLY_SECOND_LOOK=

# ─── Stealth gate (pre-launch) ───────────────────────────────────────
# While "true" (or unset), anonymous visitors only see the coming-soon
# homepage and /demo; every other route redirects home unless the
# tester cookie is present. Set to "false" to open the full site.
# Local development: false, so you can see everything.
NEXT_PUBLIC_STEALTH_MODE=false
# Password for /demo tester access while stealth is on.
DEMO_PASSWORD=

# ─── Live M8 chat (/chat, C1–C4) ────────────────────────────────────
# Claude API key. Used by /api/m8-chat (the public chat) and by
# /api/second-look (when SECOND_LOOK_LIVE=true). Without it the chat
# answers "M8 is temporarily unavailable".
ANTHROPIC_API_KEY=
# Kill switch: "false" turns the live chat off. Anything else = on.
M8_LIVE_CHAT=
# Optional overrides (defaults in lib/m8/server.ts): the model, turns per
# chat (40), daily token budget (2000000), and the salt for hashing IPs.
M8_MODEL=
M8_MAX_TURNS=
M8_DAILY_TOKEN_CAP=
M8_IP_SALT=

# Upstash Redis: rate limits, the turn cap and the daily budget across all
# servers. Unset = each server counts on its own (weaker). Vercel's Upstash
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres: redacted chat transcripts (kept 3 years) and handoff
# requests. Unset = nothing is stored on our servers, and the chat and
# privacy page say so. Vercel's Neon integration sets DATABASE_URL.
DATABASE_URL=

# Email through Resend: handoff requests to the loan officer, the
# /chat "Talk to" question form, and budget alerts.
RESEND_API_KEY=
MLO_NOTIFICATION_EMAIL=
LOANM8_FROM_EMAIL=
# Where M8 alerts go (default: MLO_NOTIFICATION_EMAIL).
M8_ALERT_EMAIL=

# ─── Monitoring (C5) ─────────────────────────────────────────────────
# Sentry: server errors and guard events from the chat (reasons only,
# never chat text). Unset = off. Copy the DSN from Sentry → Project
# Settings → Client Keys.
SENTRY_DSN=
# Token for /api/health?deep=1 (key and model check plus which switches
# are on). Any long random string. Unset = only the basic check works.
HEALTH_CHECK_TOKEN=

# ─── Reserved, off by default ────────────────────────────────────────
# Real Loan Estimate upload + decode. Keep false until the Second Look
# prompt (lib/prompts/second-look.ts) is final.
SECOND_LOOK_LIVE=false
