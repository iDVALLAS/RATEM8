# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to git.

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://loanm8.com
# Public contact address rendered on the site. Leave empty to show the
# bracketed placeholder from lib/config.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Calendly booking URLs (every consumer CTA is one of these) ──────
# Empty → the CTA renders as "Booking link coming soon", never a dead link.
NEXT_PUBLIC_CALENDLY_BORROWER=
NEXT_PUBLIC_CALENDLY_AGENT=
NEXT_PUBLIC_CALENDLY_MLO=
NEXT_PUBLIC_CALENDLY_SECOND_LOOK=

# ─── Tester preview (L3) ─────────────────────────────────────────────
# The stealth gate is gone (L3). DEMO_PASSWORD now unlocks only the hidden
# tester view at /chat?preview=1 (two-way M8 chat, when M8_LIVE_CHAT is on)
# and the /design style guide. Unset → no tester access at all.
DEMO_PASSWORD=

# ─── Reserved, off by default ────────────────────────────────────────
# Model API key. Used ONLY by /api/second-look (when SECOND_LOOK_LIVE=true)
# and the tester view at /chat?preview=1. Public /chat never calls it.
ANTHROPIC_API_KEY=
# Real Loan Estimate upload + decode. Keep false until counsel confirms
# retention and the prompt in lib/prompts/second-look.ts is reviewed.
SECOND_LOOK_LIVE=false

# ─── Email: questions from the /chat composer go to the loan officer ──
RESEND_API_KEY=
MLO_NOTIFICATION_EMAIL=
LOANM8_FROM_EMAIL=

# ─── Feature flags (all server-side; see lib/config.ts) ──────────────
# Live M8 tab on /demo and /api/m8-chat. Exactly "true" to enable.
M8_LIVE_CHAT=
# Optional model override for /api/m8-chat.
M8_MODEL=
# MLO routing. "true"/"false"; unset = on for Vercel previews, off in production.
MLO_ROUTING=
# Pricing display (Patch A). L3: example pricing is OFF unless "true" (QA only).
PRICING_DEMO_EXAMPLES=
PRICING_MANUAL=
PRICING_MANUAL_STALE_HOURS=24
PRICING_LIVE=
PRICING_RATESHEET=
PRICING_STORE_DIR=
SHOW_NATIONAL_AVG_COMPARISON=

# ─── MLO admin (/mlo/*, HTTP Basic; routes 404 while unset) ──────────
MLO_ADMIN_USER=
MLO_ADMIN_PASSWORD=

# ─── Per-MLO links ────────────────────────────────────────────────────
APPLICATION_URL_MLO_001=
APPLICATION_URL_MLO_002=
NEXT_PUBLIC_CALENDLY_RYDER=

# ─── Public contact overrides ────────────────────────────────────────
NEXT_PUBLIC_DEMO_CONTACT_EMAIL=
NEXT_PUBLIC_INVESTOR_CONTACT_HREF=

# ─── Build (L1) ───────────────────────────────────────────────────────
# "true" makes check:licensing fail on any unconfirmed licensing value even
# on a preview. Vercel production builds are always strict.
LICENSING_STRICT=

# ─── M8 voice (v33) ──────────────────────────────────────────────────
# "elevenlabs" reads M8's replies with ElevenLabs (needs the key below);
# anything else uses the device's built-in voice. Listening always uses
# the browser's speech recognition.
VOICE_PROVIDER=elevenlabs
# Server only. Mark it Sensitive in Vercel. Never NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Optional: another ElevenLabs voice or model (defaults in lib/config.ts).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
